# Copy this file to .env and fill in your own values.
# OpenRouter API key used by all model and OCR requests.
OPENROUTER_API_KEY=

# Max time (ms) a single OpenRouter request may run before it is aborted.
# Default: 30000. Raise if the model is slow to respond.
OPENROUTER_REQUEST_TIMEOUT_MS=30000

# Retry a timeout AbortError with backoff. Correct: a 429 is a transient
# RPM/TPM burst that hangs inside the provider request. Set to "0" to restore strict
# fail-fast behavior.
OPENROUTER_RETRY_TIMEOUTS=1

# How many files may be analyzed in parallel within a batch. Default 3.
ANALYSIS_FILE_CONCURRENCY=3

# Small inter-file delay (ms) when pacing document analysis.
ANALYSIS_FILE_DELAY_MS=0

# How many e-Oglasna result pages to scan per query for discovery. Default 5.
DISCOVERY_MAX_PAGES_SCANNED=5

# Hard ceiling for the "Sve dostupne" (full) scan-depth mode. Default 200.
FULL_SCAN_MAX_PAGES=200

# Allowed browser origin for CORS (the Vite dev server on :3000).
CORS_ORIGIN=http://localhost:3000

# Backend HTTP port. Default: 3001.
PORT=3001

# Directory where analysis runs/events JSON files are persisted.
# Defaults to <repo>/backend/data/analysis. Override for custom locations.
# ANALYSIS_DATA_DIR=

# Persistent URL-keyed download cache for e-Oglasna attachments (immutable
# documents are fetched once and reused across runs/restarts).
# Defaults to <repo>/backend/uploads/.dl-cache. Override for custom locations.
# DOWNLOAD_CACHE_DIR=

# Persistent OCR page cache: vision-extracted page text keyed by document
# content hash, so repeat analyses over unchanged scans spend no vision quota.
# Namespaced by prompt version + model; safe to delete at any time.
# Defaults to <repo>/backend/data/ocr-cache. Override for custom locations.
# OCR_CACHE_DIR=

# Raster OCR rendering goes through OpenRouter; documents are never uploaded
# to a provider as native PDFs. Limit the number of pages processed per file.
OCR_MAX_PAGES=20

# Raster OCR rendering controls. Defaults preserve the legacy 72-DPI rendering
# path (scale 1, max long edge 2000px). Test higher settings on frozen fixtures
# before changing a deployment default; e.g. scale 3.5, long edge 3072.
# OCR_RENDER_SCALE=1
# OCR_IMAGE_LONG_EDGE=2000

# e-Registar / SudReg query access. Optional — only needed when querying the
# Croatian e-Oglasna search endpoint for live data.
COURT_REGISTRY_API_URL=
COURT_REGISTRY_CLIENT_ID=
COURT_REGISTRY_CLIENT_SECRET=
