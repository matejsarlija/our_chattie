# Copy this file to .env and fill in your own values.
# GOOGLE_API_KEY is REQUIRED — the server refuses to start without it.

# Required. Google AI Studio API key (https://aistudio.google.com/apikey).
# The court-analysis pipeline calls the Gemini API with this key.
GOOGLE_API_KEY=

# Gemini model used across the analysis pipeline (analysis agent, visualizer,
# synthesizer, verifier). Override to test other models.
GEMINI_MODEL=gemini-2.5-flash

# Max time (ms) a single Gemini request may run before it is aborted by the
# fail-fast guard. Default: 30000. Raise if the model is slow to respond.
GEMINI_REQUEST_TIMEOUT_MS=30000

# Retry a timeout AbortError with backoff. This is correct on a paid key where
# a 429 is a transient RPM/TPM burst that hangs inside the SDK. Set to "0" to
# restore strict fail-fast behavior (e.g. conserving a tiny free quota).
GEMINI_RETRY_TIMEOUTS=1

# Allowed browser origin for CORS (the Vite dev server on :3000).
CORS_ORIGIN=http://localhost:3000

# Backend HTTP port. Default: 3001.
PORT=3001

# Directory where analysis runs/events JSON files are persisted.
# Defaults to <repo>/backend/data/analysis. Override for custom locations.
# ANALYSIS_DATA_DIR=

# e-Registar / SudReg query access. Optional — only needed when querying the
# Croatian e-Oglasna search endpoint for live data.
COURT_REGISTRY_API_URL=
COURT_REGISTRY_CLIENT_ID=
COURT_REGISTRY_CLIENT_SECRET=
