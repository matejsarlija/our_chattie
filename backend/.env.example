# Copy this file to .env and fill in your own values.
# GOOGLE_API_KEY is REQUIRED — the server refuses to start without it.

# Required. Google AI Studio API key (https://aistudio.google.com/apikey).
# The court-analysis pipeline calls the Gemini API with this key.
GOOGLE_API_KEY=

# Gemini model used across the analysis pipeline (analysis agent, visualizer,
# synthesizer, verifier). Override to test other models.
GEMINI_MODEL=gemini-2.5-flash

# Max time (ms) a single Gemini request may run before it is aborted by the
# fail-fast guard. Default: 30000. Raise if the model is slow to respond.
GEMINI_REQUEST_TIMEOUT_MS=30000

# Track 3b — full document history. How many raw e-Oglasna entries to capture
# per analysis run. Leave unset (recommended) to capture the entire scanned
# search window so the selected primary cluster's full document history is
# downloaded/analyzed, not just the top (caseLimit*3) entries. Set a positive
# integer to re-impose a cap and conserve quota/requests.
# ANALYSIS_SCRAPE_LIMIT=

# Retry a timeout AbortError with backoff. This is correct on a paid key where
# a 429 is a transient RPM/TPM burst that hangs inside the SDK. Set to "0" to
# restore strict fail-fast behavior (e.g. conserving a tiny free quota).
GEMINI_RETRY_TIMEOUTS=1

# Free vs paid plan drives the 429/timeout policy. This is a fallback for fresh
# installs only — the dashboard toggle (persisted in settings.json, editable via
# PUT /api/settings) is the source of truth once the user has chosen a plan.
# GEMINI_PLAN=free

# How many files may be analyzed in parallel within a batch. Default 1 (serial)
# to conserve the free-tier quota; raise to 3-4 on a paid key.
ANALYSIS_FILE_CONCURRENCY=1

# Small inter-file delay (ms) when pacing document analysis on the free plan.
ANALYSIS_FILE_DELAY_MS=0

# How many e-Oglasna result pages to scan per query for discovery. Default 5.
DISCOVERY_MAX_PAGES_SCANNED=5

# Hard ceiling for the "Sve dostupne" (full) scan-depth mode. Default 200.
FULL_SCAN_MAX_PAGES=200

# Allowed browser origin for CORS (the Vite dev server on :3000).
CORS_ORIGIN=http://localhost:3000

# Backend HTTP port. Default: 3001.
PORT=3001

# Directory where analysis runs/events JSON files are persisted.
# Defaults to <repo>/backend/data/analysis. Override for custom locations.
# ANALYSIS_DATA_DIR=

# e-Registar / SudReg query access. Optional — only needed when querying the
# Croatian e-Oglasna search endpoint for live data.
COURT_REGISTRY_API_URL=
COURT_REGISTRY_CLIENT_ID=
COURT_REGISTRY_CLIENT_SECRET=
