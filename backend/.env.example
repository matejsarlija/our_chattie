# Copy this file to .env and fill in your own values.
# OpenRouter API key used by all model, OCR, and verification requests.
OPENROUTER_API_KEY=

# Max single-request fallback timeout (ms). SSE stream calls use a 60s idle
# watchdog and 240s total timeout in backend/llm/openrouterClient.js.
OPENROUTER_REQUEST_TIMEOUT_MS=30000

# Retry transient AbortError / stream idle timeouts with backoff (0 to disable).
OPENROUTER_RETRY_TIMEOUTS=1

# ProviderPoolRegistry per-lane concurrency bounds.
OPENROUTER_POOL_Z_AI=3
OPENROUTER_POOL_MISTRAL_OCR=3
OPENROUTER_POOL_GEMMA=4
OPENROUTER_POOL_GEMINI=4

# How many files may be dispatched concurrently inside documentAnalyzer (defaults 4).
ANALYSIS_FILE_CONCURRENCY=4
ANALYSIS_FILE_DELAY_MS=0

# Stage T OCR configuration: 15p windows up to 60p (40 head + 20 tail).
OCR_PROVIDER=auto
OCR_BATCH_WINDOW_PAGES=15
MAX_DOC_OCR_PAGES=60
# OCR_RENDER_SCALE=1
# OCR_IMAGE_LONG_EDGE=2000

# How many e-Oglasna result pages to scan per query for discovery. Default 5.
DISCOVERY_MAX_PAGES_SCANNED=5
FULL_SCAN_MAX_PAGES=200

# Allowed browser origin for CORS (the Vite dev server on :3000).
CORS_ORIGIN=http://localhost:3000
PORT=3001

# Data/cache paths (all unified SQLite + URL download cache by default).
# ANALYSIS_DATA_DIR=
# DOWNLOAD_CACHE_DIR=

# SudReg query access (optional).
COURT_REGISTRY_API_URL=
COURT_REGISTRY_CLIENT_ID=
COURT_REGISTRY_CLIENT_SECRET=
