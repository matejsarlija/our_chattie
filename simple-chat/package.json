  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "cra:start": "react-scripts start",
    "cra:build": "react-scripts build",
    "test": "react-scripts test",
    "test:unit": "react-scripts test --watch=false",
    "test:ci": "react-scripts test --watch=false --passWithNoTests",
